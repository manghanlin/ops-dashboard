# 複製此檔案為 .env，填入真實值，.env 不進 git

# JWT 簽章密鑰（請換成隨機長字串，例如：openssl rand -hex 32）
JWT_SECRET=your-secret-key-change-me

# Access Token 有效分鐘數
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 管理員帳號
ADMIN_USER=admin

# 管理員密碼（bcrypt hash）
# 產生方式：python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('你的密碼'))"
ADMIN_HASHED_PW=$2b$12$xxxxxxxxxxxxxxxxxxxxxx

# Redis 密碼
REDIS_PASS=your-redis-password

# 允許的前端來源（逗號分隔，正式環境填內網 IP 或 hostname）
CORS_ORIGINS=http://localhost,http://127.0.0.1
